name = "love-story-analytics"
main = "src/index.js"
compatibility_date = "2026-09-10"

# Se frontend e backend estiverem em domínios diferentes, coloque o domínio do site.
[vars]
ALLOWED_ORIGIN = "*"

[[d1_databases]]
binding = "DB"
database_name = "love-story-analytics"
database_id = "COLE_O_DATABASE_ID_AQUI"
